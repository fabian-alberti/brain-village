{
  "expo": {
    "name": "Brain Village",
    "slug": "brain-village",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/App Icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "brain-village",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2D5A3D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brainvillage.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "instagram",
          "tiktok",
          "twitter",
          "fb",
          "snapchat",
          "linkedin",
          "pinterest",
          "reddit",
          "barcelona",
          "bereal",
          "robloxmobile",
          "minecraft",
          "candycrush",
          "clashroyale",
          "amongus",
          "brawlstars",
          "genshinimpact",
          "pubgmobile",
          "youtube",
          "nflx",
          "twitch",
          "disneyplus",
          "spotify",
          "music",
          "aiv",
          "hbomax",
          "duolingo",
          "khanacademy",
          "coursera",
          "quizlet",
          "notion",
          "anki",
          "googlechrome",
          "maps",
          "calshow",
          "strava",
          "myfitnesspal",
          "headspace",
          "calm",
          "nikerunclub",
          "x-apple-health",
          "applenews",
          "flipboard",
          "kindle",
          "medium",
          "pocket",
          "feedly",
          "whatsapp",
          "tg",
          "messages",
          "discord",
          "sgnl",
          "fb-messenger"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/App Icon.png",
        "backgroundColor": "#2D5A3D"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.brainvillage.app"
    },
    "web": {
      "favicon": "./assets/App Icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
"icon": "./assets/App Icon.png",
            "color": "#2D5A3D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
